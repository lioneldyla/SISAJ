# Copy to .env only for local development. Do not commit secrets.
SISA_DB_PATH=./data/sisa.db
SISA_BACKUP_DIR=./backups

# Render demo: DATABASE_URL must reference a dedicated PostgreSQL database.
# Never put production credentials or real records in this file.
SISA_DEPLOYMENT=local
SISA_DATA_MODE=synthetic
SISA_SECURE_COOKIE=0
# SISA_BOOTSTRAP_KEY: set securely in Render, never commit its value.


# HTTP setup always requires a non-empty SISA_BOOTSTRAP_KEY.
# Local operator alternative: python scripts/provision_admin.py USERNAME
# Never place the bootstrap key or passwords in this example file.
